{
  "Comment": "CCMP-200 Serverless Image Processing Capstone",
  "StartAt": "ResizeImage",
  "States": {
    "ResizeImage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$",
      "Parameters": {
        "Payload.$": "$",
        "FunctionName": "arn:aws:lambda:us-east-2:575607844351:function:ccmp200-image-resizer:$LATEST"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "InputPath": "$",
      "ResultPath": "$.lambdaResult",
      "Next": "CheckResizeStatus"
    },
    "CheckResizeStatus": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.lambdaResult.Payload.status",
          "StringEquals": "SUCCESS",
          "Next": "ImageProcessingSuccess"
        }
      ],
      "Default": "ImageProcessingFailed"
    },
    "ImageProcessingSuccess": {
      "Type": "Succeed"
    },
    "ImageProcessingFailed": {
      "Type": "Fail",
      "Error": "ImageProcessingError",
      "Cause": "Lambda image processing failed"
    }
  },
  "QueryLanguage": "JSONPath"
}